<odoo>
    <record id="view_loan_application_reject_wizard_form" model="ir.ui.view">
        <field name="name">loan.application.reject.wizard.form</field>
        <field name="model">loan.application.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar Solicitud">
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Confirmar Rechazo" type="object" name="confirm_rejection" class="btn-danger"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="loan_application_reject_wizard_action" model="ir.actions.act_window">
        <field name="name">Rechazar Préstamo</field>
        <field name="res_model">loan.application.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_application_id': active_id}</field>
    </record>
</odoo>
