<odoo>
    <record id="view_partner_form_loan_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.loan.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button name="action_view_applications"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file"
                        invisible="application_count == 0">
                    <field name="application_count" widget="statinfo" string="Préstamos"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
